{
  "manifest_version": 3,
  "name": "Полигон контейнерных поездов",
  "version": "1.2.0",
  "description": "База данных контейнерных поездов и картографическая схема с экспортом в PDF.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Открыть Полигон контейнерных поездов",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "version_name": "1.2.0 — 05.11.2026"
}
